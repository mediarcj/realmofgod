# File: .editorconfig
# Description: Defines shared text-file formatting defaults.
# Purpose: Keeps basic formatting consistent across editors and operating systems.
# Notes: None.

root = true

# Use portable UTF-8 text with a final newline and two-space indentation.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Preserve intentional Markdown line breaks.
[*.md]
trim_trailing_whitespace = false
